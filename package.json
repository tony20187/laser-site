{
  "name": "laser-site",
  "version": "2025.11.22-1",
  "description": "華谷電機專用雷射應用程式",
  "author": "機工課雷射組-副組長 李書宏 <tony20187@gmail.com>",
  "main": "main.js",
  "homepage": "https://tony20187.github.io/laser-site",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && cross-env APP_MODE=app electron .",
    "serve": "npm run build && npm run start",
    "dist": "electron-builder",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev-electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\""
  },
  "build": {
    "productName": "華谷電機雷射世界",
    "appId": "com.huagu.lasersite",
    "copyright": "Copyright © 2025 Tony",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/HWAGUO-LS.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "華谷電機雷射世界"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^27.3.11",
    "electron-builder": "^24.13.3",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "vite": "^4.5.14",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3"
  }
}
